{
  "extends": "@sapphire/ts-config",
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@lib/*": ["./src/lib/*"]
    }
  }
}
