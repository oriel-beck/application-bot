BOT_TOKEN=your_discord_bot_token
DATABASE_URL=postgresql://appbot:your_postgres_password@postgres:5432/appbot
# Used by the postgres service in docker-compose.yml (must match DATABASE_URL credentials)
POSTGRES_USER=appbot
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=appbot
PGDATA=/var/lib/postgresql/data/pgdata
OWNER=your_discord_user_id
REDIS_HOST=redis
CHROMA_URL=http://chroma:8000
OPENAI_API_KEY=your_openai_api_key

# Optional: guard rails for /eval command in production
# NODE_ENV=production
# EVAL_ENABLED=false
